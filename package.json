{
  "name": "mcp-repo-devtools",
  "version": "0.1.0",
  "description": "Read-only MCP server for git history, GitHub issues and CI failures.",
  "type": "module",
  "bin": {
    "mcp-repo-devtools": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "npm run build && node --import tsx --test tests/text.test.ts tests/config.test.ts tests/git.test.ts tests/github.test.ts tests/server.test.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "git",
    "github",
    "ci",
    "developer-tools"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "@types/node": "^22.10.5"
  }
}
