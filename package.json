{
  "name": "mcp-repo-devtools",
  "version": "0.4.0",
  "description": "Tool surface for coding agents: bounded git and GitHub tools, a reference agent loop, and an eval that publishes where it loses.",
  "type": "module",
  "bin": {
    "mcp-repo-devtools": "dist/index.js"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "agent": "node dist/agent/cli.js",
    "demo:agent": "node scripts/demo-agent.mjs",
    "demo:route-a": "npm run build && node scripts/demo-route-a.mjs",
    "eval": "node dist/eval/cli.js",
    "eval:baseline": "node dist/eval/cli.js --arm baseline --kind git",
    "eval:check": "node dist/eval/cli.js --check eval/baseline.json",
    "eval:record": "node scripts/record-baseline.mjs",
    "test": "npm run build && node --import tsx --test tests/text.test.ts tests/config.test.ts tests/zip.test.ts tests/git.test.ts tests/github.test.ts tests/server.test.ts tests/structured-output.test.ts tests/request-context.test.ts tests/progress.test.ts tests/contract.test.ts tests/agent-loop.test.ts tests/agent-provider.test.ts tests/agent-mcp.test.ts tests/agent-openai.test.ts tests/eval-grade.test.ts tests/eval-run.test.ts tests/eval-github.test.ts tests/eval-baseline.test.ts tests/route-a.test.ts",
    "bench": "npm run build && node bench/measure.mjs",
    "snapshot": "node --import tsx scripts/contract-snapshot.mjs",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "coding-agent",
    "ai-agent",
    "agent-tools",
    "llm-tools",
    "git",
    "github",
    "ci",
    "developer-tools",
    "evaluation",
    "claude-code",
    "codex",
    "cursor"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MAOLVLHL/mcp-repo-devtools.git"
  },
  "homepage": "https://github.com/MAOLVLHL/mcp-repo-devtools#readme",
  "bugs": {
    "url": "https://github.com/MAOLVLHL/mcp-repo-devtools/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "@types/node": "^26.6.6"
  }
}